rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regular user profiles and bank details
    match /users/{userId} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Deposits and VIP pack verification rules
    match /deposits/{depositId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null;
    }

    // Withdrawal requests and payout queue rules
    match /withdrawals/{withdrawalId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null;
    }

    // Customer Care / Live Chat support rules
    match /support_chats/{chatId} {
      allow read, create, update: if request.auth != null;
    }

    match /support_messages/{msgId} {
      allow read, create, update: if request.auth != null;
    }
  }
}
